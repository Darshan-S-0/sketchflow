# SketchFlow Backend Environment Configuration
# Copy this file to `.env` in this directory and add your real Gemini API key.

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Active Vision Model (Recommended: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
