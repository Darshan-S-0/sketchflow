# SketchFlow Environment Configuration
# Copy this file to `backend/.env` for backend setup and `frontend/.env` for frontend overrides.

# ==========================================
# Backend Configuration (backend/.env)
# ==========================================

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Active Vision Model (Recommended: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Allowed CORS Origins (comma-separated, optional)
# Render frontends matching https://*.onrender.com and localhost are allowed by default.
ALLOWED_ORIGINS=https://sketchflow-6d65.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Frontend Configuration (frontend/.env)
# ==========================================

# FastAPI Backend URL
# In local development: defaults to http://127.0.0.1:8000
# In production on Render: defaults to https://sketchflow-6d65.onrender.com
VITE_API_URL=https://sketchflow-6d65.onrender.com
