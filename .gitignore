# ============================================
# Git Ignore for SketchFlow
# ============================================

# Secrets & Environment variables (NEVER COMMIT)
.env
.env.*
*.env
backend/.env
frontend/.env
!*.env.example
!.env.example
!backend/.env.example

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
backend/.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Build outputs
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
.oxlint_cache/

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor files
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# Local Logs & Temporary files
*.log
logs/
temp/
tmp/
